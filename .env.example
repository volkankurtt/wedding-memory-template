# Copy to backend/.env (or your host). Do not commit real secrets.

# PostgreSQL
# IPv6: Direct Connection, port 5432
# IPv4: Session Pooler, port 5432
# Do not use Transaction Pooler (port 6543).
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=change-me

# Storage — uploads go through Spring with the service role only.
# Bucket guest-photos: public read, private write.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_STORAGE_BUCKET=guest-photos
# Optional. Default: ${SUPABASE_URL}/storage/v1/object/public/${bucket}
SUPABASE_PUBLIC_STORAGE_BASE_URL=

# Comma-separated browser origins. Do not use *.
CORS_ORIGINS=http://localhost:5173

# Set true only behind a reverse proxy that you control.
TRUST_FORWARDED_HEADERS=false
TRUSTED_PROXIES=127.0.0.1,::1

# Required before production for DELETE /api/admin/*
ADMIN_TOKEN=change-me

# Optional ImageMagick binary name
MAGICK_COMMAND=magick
